#!/bin/zsh
# Demo assistant for "(Agentic) Loops At Levels, Live".
#
#   ./bin/demo preflight <level>   check the machine is ready; --fix repairs what is safe
#                                  levels 1-5; 2-5 share one profile, 5 adds a second plugin
#   ./bin/demo run <level>         teleprompt the segment, one beat at a time
#                                  <level> is opening, 1-5, upper, or sentinels
#   ./bin/demo run <level> --time  the same, timed, with a variance table at the end
#   ./bin/demo fallback <level>    abandon a wandering live run
#   ./bin/demo profiles            show the profile table and auth state
#
# Beats live in bin/steps-level-<n>.txt so they can be edited without touching this file.
# Nothing here talks to a model: it is deliberately boring, so it cannot surprise you
# on stage.

set -u
emulate -L zsh
setopt no_nomatch

HERE=${0:A:h}
NOTES=${HERE:h}
REPO=${REPO:-$HOME/code/Habitat-Thinking/petclinic-loops-at-levels}
PIN_CC_VERSION="2.1.275"   # clean room re-verified on this build, 2026-09-19
PIN_LEGIBILITY_VERSION="0.11.0"   # Level 5 only: the legibility instrument
PIN_PLUGIN_VERSION="0.92.0"   # #616: edit hook is a script; no false "no HARNESS.md", no turn cut-off

# Colours, dropped when not a terminal.
if [[ -t 1 ]]; then
  B=$'\e[1m'; DIM=$'\e[2m'; R=$'\e[0m'; GRN=$'\e[32m'; RED=$'\e[31m'; YEL=$'\e[33m'; CYN=$'\e[36m'
else
  B=""; DIM=""; R=""; GRN=""; RED=""; YEL=""; CYN=""
fi

ok(){ print -r -- "${GRN}  ok  ${R} $1" }
bad(){ print -r -- "${RED} FAIL ${R} $1"; FAILED=$((FAILED+1)) }
warn(){ print -r -- "${YEL} warn ${R} $1"; WARNED=$((WARNED+1)) }
hdr(){ print -r -- ""; print -r -- "${B}$1${R}" }

zmodload -F zsh/datetime b:strftime p:EPOCHSECONDS 2>/dev/null

# Parse a TIME: budget to whole seconds. "90s" -> 90, "2 min" -> 120.
# Anything else returns 0, which the report prints as "—" rather than guessing a
# number: a budget nobody wrote is not a budget of zero.
budget_secs(){
  local t=$1
  # <-> matches a run of digits. A looser `*s` would parse "bogus" as "bogu",
  # and a looser `*min*` would leave the multiplicand empty on a bare "min".
  case $t in
    <->*min*) print -r -- $(( ${t%%[^0-9]*} * 60 )) ;;
    <->s)     print -r -- ${t%s} ;;
    <->)      print -r -- $t ;;
    *)        print -r -- 0 ;;
  esac
}
mmss(){ printf '%d:%02d' $(( $1 / 60 )) $(( $1 % 60 )) }
# Signed, for the delta column. A plain mmss would render -12 as 0:-12.
mmss_signed(){
  local v=$1 sign=+
  (( v < 0 )) && { sign=-; v=$(( -v )) }
  printf '%s%d:%02d' $sign $(( v / 60 )) $(( v % 60 ))
}

# Levels 2 and 3 deliberately share a profile: from Level 3 on, what changes is in the
# repository, not the launcher.
profile_dir(){ [[ $1 == 1 ]] && print -r -- "$HOME/.claude-loops-at-levels" || print -r -- "$HOME/.claude-loops-at-levels-l2" }
branch_for(){
  case $1 in
    1) print -r -- "level-1-dictating" ;;
    2) print -r -- "level-2-commanding" ;;
    3) print -r -- "level-3-regulating" ;;
    4) print -r -- "level-4-orchestrating" ;;
    5) print -r -- "level-5-supervising" ;;
    *) print -r -- "level-$1" ;;
  esac
}
# Levels 1-3 fall back to an `-after` sibling holding that level's agent output.
# Level 4 has none: its pipeline is entered at a checkpoint instead, because the
# full loop does not fit in stage time and the checkpoints are the fallback.
after_for(){ [[ $1 == 4 || $1 == 5 ]] && print -r -- "" || print -r -- "$(branch_for $1)-after" }

# Level 4 checkpoints, in the order the segment visits them.
L4_CHECKPOINTS=(l4-1-sliced l4-2-spec l4-3-objections l4-4-choices l4-5-reviewed)

# Auth check must not export USER: with a custom CLAUDE_CONFIG_DIR a set USER breaks
# the keychain lookup. This is the trap that would fail on stage and never in rehearsal.
auth_ok(){
  local p=$1
  env -i HOME="$HOME" PATH="$PATH" CLAUDE_CONFIG_DIR="$p" claude auth status 2>/dev/null \
    | grep -q '"loggedIn": true'
}

# The upper-levels demo is a named segment rather than a rung. It runs from
# level-4-orchestrating, dispatches no agent, and therefore needs no Claude Code
# profile, no login and no --plugin-dir — which is most of what preflight checks
# for a level. It gets its own, shorter list.
preflight_upper(){
  local fix=${1:-}
  FAILED=0; WARNED=0
  hdr "Preflight — upper levels (standalone, 20 min)"

  print -r -- "${DIM}  no Claude Code profile needed: nothing here dispatches an agent${R}"

  if [[ ! -d $REPO/.git ]]; then bad "no repository at $REPO"; hdr "Result"; return 1; fi

  local cur=$(git -C $REPO rev-parse --abbrev-ref HEAD)
  if [[ $cur == level-5-supervising ]]; then ok "on level-5-supervising"
  elif [[ $fix == --fix ]]; then
    if [[ -n $(git -C $REPO status --porcelain) ]]; then bad "cannot switch: working tree dirty"
    else git -C $REPO switch -q level-5-supervising && ok "switched to level-5-supervising"; fi
  else
    bad "on $cur, expected level-5-supervising (--fix switches)"
  fi
  [[ -z $(git -C $REPO status --porcelain) ]] && ok "working tree clean" \
    || bad "working tree dirty — beat 2 commits nothing, but a dirty tree makes the catch ambiguous"

  # Beat 2 is the only live thing in the demo, and it is the beat the payoff rests on.
  if [[ -x $REPO/scripts/check-decision-record.sh ]]; then ok "check-decision-record.sh runnable"
  else bad "scripts/check-decision-record.sh missing or not executable — beat 2 has no live catch"; fi
  local hp=$(git -C $REPO config --get core.hooksPath 2>/dev/null)
  if [[ $hp == .githooks ]]; then
    ok "git hooks enabled (core.hooksPath=.githooks)"
  elif [[ $fix == --fix ]]; then
    git -C $REPO config core.hooksPath .githooks && ok "enabled git hooks in this clone"
  else
    warn "git hooks not enabled — beat 2 still runs the script directly, but the commit-time
       framing is weaker. git -C $REPO config core.hooksPath .githooks   (--fix does it)"
  fi

  # Beat 5 reads one file out of the checkpoint without checking it out.
  git -C $REPO show-ref -q --verify refs/heads/l4-1-sliced && ok "checkpoint l4-1-sliced present" \
    || bad "l4-1-sliced missing — beat 5 has nothing to show"

  # The artefacts the later beats read.
  local missing=0 f=""
  for f in docs/superpowers decisions PIPELINE.md HARNESS.md; do
    [[ -e $REPO/$f ]] || { bad "$f missing from the ladder checkout"; missing=1 }
  done
  (( missing == 0 )) && ok "pipeline artefacts present (docs/superpowers, decisions, PIPELINE.md, HARNESS.md)"
  missing=0
  for f in level-5/trust-boundary.txt level-5/diagnosis.yaml level-5/descent.md upper-levels/slides/UPPER-LEVELS.md; do
    [[ -e $NOTES/$f ]] || { bad "$f missing from the demo notes"; missing=1 }
  done
  (( missing == 0 )) && ok "demo-notes artefacts present (trust boundary, diagnosis, descent, deck)"

  hdr "Result"
  if (( FAILED > 0 )); then
    print -r -- "${RED}$FAILED blocking problem(s)${R}, $WARNED warning(s). Fix before going on."
    return 1
  fi
  print -r -- "${GRN}Ready.${R} $WARNED warning(s)."
  print -r -- "${DIM}Not checkable from here: terminal font size, scrollback cleared, notifications off.${R}"
  print -r -- "${DIM}The close is the last four beats and needs no terminal at all.${R}"
  return 0
}

# The Level 5 solo segment: twenty minutes, Levels 3 and 4 explained rather than run,
# and Level 5 demonstrated with TWO LIVE SENTINEL DISPATCHES. That is the only segment
# in the talk that dispatches an agent for the sake of the sentinel rather than the
# code, so it needs the full profile AND two things nothing else checks: a pact the
# Mast can recite, and a reservoir block the Warden can evaluate against.
#
# It is called `sentinels` and not `l5` on purpose. `./bin/demo run 5` is a different
# segment and `5` is one keystroke from `l5`; a wrong segment on stage is unrecoverable
# in a way a wrong flag is not.
preflight_sentinels(){
  local fix=${1:-} profile=$(profile_dir 5)
  FAILED=0; WARNED=0
  hdr "Preflight — Level 5 solo (20 min, two live sentinels)"

  local v=$(claude --version 2>/dev/null | awk '{print $1}')
  [[ $v == $PIN_CC_VERSION ]] && ok "Claude Code $v (as verified)" \
    || warn "Claude Code $v, notes were verified against $PIN_CC_VERSION — re-run the context audit"

  # Two live dispatches means the profile matters more here than anywhere else.
  if [[ -x $profile/launch ]]; then ok "launcher $profile/launch"; else bad "no launcher at $profile/launch"; fi
  if auth_ok $profile; then ok "profile logged in"
  else bad "profile NOT logged in — BOTH live beats fail. Run:
         env -i HOME=\"\$HOME\" PATH=\"\$PATH\" TERM=\"\$TERM\" CLAUDE_CONFIG_DIR=\"$profile\" claude auth login"; fi
  if [[ -d $profile/projects ]]; then
    if [[ $fix == --fix ]]; then rm -rf $profile/projects; ok "cleared rehearsal state"
    else warn "rehearsal state present ($profile/projects) — stale session history. (--fix clears it)"; fi
  else ok "no rehearsal state"; fi

  local pdir=$profile/plugins/cache/ai-literacy-superpowers/ai-literacy-superpowers/$PIN_PLUGIN_VERSION
  [[ -d $pdir ]] && ok "plugin ai-literacy-superpowers $PIN_PLUGIN_VERSION" \
    || bad "plugin $PIN_PLUGIN_VERSION missing at $pdir — no sentinels at all"
  local ldir=$profile/plugins/cache/ai-literacy-superpowers/diagnostic-legibility/$PIN_LEGIBILITY_VERSION
  [[ -d $ldir ]] && ok "plugin diagnostic-legibility $PIN_LEGIBILITY_VERSION" \
    || bad "plugin diagnostic-legibility $PIN_LEGIBILITY_VERSION missing at $ldir"
  (( $(grep -c -- "--plugin-dir" $profile/launch 2>/dev/null) == 2 )) \
    && ok "launcher loads both plugins" || bad "launcher does not carry both --plugin-dir flags"

  if [[ ! -d $REPO/.git ]]; then bad "no repository at $REPO"; hdr "Result"; return 1; fi
  local cur=$(git -C $REPO rev-parse --abbrev-ref HEAD)
  if [[ $cur == level-5-supervising ]]; then ok "on level-5-supervising"
  elif [[ $fix == --fix ]]; then
    if [[ -n $(git -C $REPO status --porcelain) ]]; then bad "cannot switch: working tree dirty"
    else git -C $REPO switch -q level-5-supervising && ok "switched to level-5-supervising"; fi
  else bad "on $cur, expected level-5-supervising (--fix switches)"; fi
  [[ -z $(git -C $REPO status --porcelain) ]] && ok "working tree clean" || bad "working tree dirty"

  # THE PACT. /mast recites it. Absent or malformed and the beat still runs, but it
  # reports "not opted in" instead of reciting a stop hour — which is a different demo.
  # This is also the exact symptom of the zsh BASH_SOURCE bug (issue 617), so a pact
  # written by a session on a zsh machine lands here as `malformed`.
  local pacts="$HOME/.claude/pacts.md"
  if [[ ! -f $pacts ]]; then
    bad "no pact at $pacts — the Mast beat has nothing to recite. Author one with /mast tune (NOT by hand)"
  else
    local pstate=$(bash -c '. "$1/hooks/scripts/lib/pact-blocks.sh" 2>/dev/null; block_state Budgets' _ "$pdir" 2>/dev/null)
    case $pstate in
      declared) ok "pact Budgets declared ($(bash -c '. "$1/hooks/scripts/lib/pact-blocks.sh" 2>/dev/null; block_key Budgets hard_stop_hour' _ "$pdir" 2>/dev/null))" ;;
      malformed) bad "pact Budgets is MALFORMED — the Mast drops to observe-only and recites nothing.
         Almost certainly issue 617: a pact written from zsh loses its governing clause. Re-run /mast tune" ;;
      *) bad "pact Budgets is $pstate — the Mast beat has nothing to recite" ;;
    esac
  fi

  # THE RESERVOIR BLOCK. /reservoir refuses to manufacture a read without it.
  grep -q '^## Cognitive reservoir' $REPO/HARNESS.md 2>/dev/null \
    && ok "HARNESS.md carries the Cognitive reservoir block" \
    || bad "no Cognitive reservoir block in HARNESS.md — /reservoir will decline to read"

  # Level 3 and 4 are explained from artefacts, not run — but the artefacts must be there.
  local missing=0 f=""
  for f in PIPELINE.md HARNESS.md docs/superpowers decisions scripts/check-decision-record.sh; do
    [[ -e $REPO/$f ]] || { bad "$f missing — the foundations slides have nothing behind them"; missing=1 }
  done
  (( missing == 0 )) && ok "L3/L4 foundation artefacts present"
  missing=0
  for f in sentinels/captures/trust-boundary.txt level-5/diagnosis.yaml level-5/descent.md \
           level-5/reservoir-reading.md sentinels/slides/LEVEL-5.md; do
    [[ -e $NOTES/$f ]] || { bad "$f missing from the demo notes"; missing=1 }
  done
  (( missing == 0 )) && ok "demo-notes artefacts present (trust boundary, diagnosis, descent, assessment, deck)"

  # The captured fallbacks for the two live beats.
  missing=0
  for f in sentinels/captures/mast.txt sentinels/captures/reservoir.txt \
           sentinels/captures/wip.txt sentinels/captures/cost-estimate.txt; do
    [[ -s $NOTES/$f ]] || { warn "$f missing or empty — that live beat has no fallback"; missing=1 }
  done
  (( missing == 0 )) && ok "all four sentinel captures present"

  hdr "Result"
  if (( FAILED > 0 )); then
    print -r -- "${RED}$FAILED blocking problem(s)${R}, $WARNED warning(s). Fix before going on."
    return 1
  fi
  print -r -- "${GRN}Ready.${R} $WARNED warning(s)."
  print -r -- "${DIM}Two beats dispatch a live agent. Both are read-only sentinels and neither${R}"
  print -r -- "${DIM}can write to the repository — but both cost stage time you cannot predict.${R}"
  print -r -- "${DIM}The captured fallbacks are in sentinels/captures/. Say it is a recording.${R}"
  return 0
}

preflight(){
  local level=$1 fix=${2:-}
  local profile=$(profile_dir $level) branch=$(branch_for $level) after=$(after_for $level)
  FAILED=0; WARNED=0

  hdr "Preflight — Level $level"

  # Docker: the database integration tests skip silently without it.
  if docker info >/dev/null 2>&1; then
    ok "Docker running ($(docker info --format '{{.ServerVersion}}' 2>/dev/null))"
  elif [[ $fix == --fix ]]; then
    print -r -- "      starting Docker Desktop…"
    open -a Docker
    local n=0
    while ! docker info >/dev/null 2>&1 && (( n < 60 )); do sleep 2; n=$((n+1)); done
    docker info >/dev/null 2>&1 && ok "Docker started" || bad "Docker did not start"
  else
    bad "Docker not running — 2 tests will skip and '78 tests' becomes 76. (--fix starts it)"
  fi

  # Claude Code version: the clean-room behaviour was verified against one build.
  local v=$(claude --version 2>/dev/null | awk '{print $1}')
  [[ $v == $PIN_CC_VERSION ]] && ok "Claude Code $v (as verified)" \
    || warn "Claude Code $v, notes were verified against $PIN_CC_VERSION — re-run the context audit"

  # Profile: logged in, and clean of rehearsal state.
  if [[ -x $profile/launch ]]; then ok "launcher $profile/launch"; else bad "no launcher at $profile/launch"; fi
  if auth_ok $profile; then
    ok "profile logged in"
  else
    bad "profile NOT logged in — run:
         env -i HOME=\"\$HOME\" PATH=\"\$PATH\" TERM=\"\$TERM\" CLAUDE_CONFIG_DIR=\"$profile\" claude auth login"
  fi
  if [[ -d $profile/projects ]]; then
    if [[ $fix == --fix ]]; then rm -rf $profile/projects; ok "cleared rehearsal state"
    else warn "rehearsal state present ($profile/projects) — stale session history. (--fix clears it)"; fi
  else
    ok "no rehearsal state"
  fi

  # Level 2 only: the plugin, pinned.
  if [[ $level == 2 || $level == 3 || $level == 4 || $level == 5 ]]; then
    local pdir=$profile/plugins/cache/ai-literacy-superpowers/ai-literacy-superpowers/$PIN_PLUGIN_VERSION
    [[ -d $pdir ]] && ok "plugin ai-literacy-superpowers $PIN_PLUGIN_VERSION" \
      || bad "plugin $PIN_PLUGIN_VERSION missing at $pdir"
    grep -q -- "--plugin-dir" $profile/launch 2>/dev/null && ok "launcher loads the plugin" \
      || bad "launcher is missing --plugin-dir"
    # Level 5 adds the legibility instrument — the first launcher change since Level 3.
    if [[ $level == 5 ]]; then
      local ldir=$profile/plugins/cache/ai-literacy-superpowers/diagnostic-legibility/$PIN_LEGIBILITY_VERSION
      [[ -d $ldir ]] && ok "plugin diagnostic-legibility $PIN_LEGIBILITY_VERSION" \
        || bad "plugin diagnostic-legibility $PIN_LEGIBILITY_VERSION missing at $ldir"
      (( $(grep -c -- "--plugin-dir" $profile/launch 2>/dev/null) == 2 )) \
        && ok "launcher loads both plugins" \
        || bad "launcher does not carry both --plugin-dir flags (Level 5 needs the legibility instrument)"
    fi
  else
    grep -q -- "--plugin-dir" $profile/launch 2>/dev/null \
      && bad "Level 1 launcher has --plugin-dir — that is the Level 2 profile" \
      || ok "launcher has no plugin (correct for Level 1)"
  fi

  # Repository state.
  if [[ -d $REPO/.git ]]; then
    local cur=$(git -C $REPO rev-parse --abbrev-ref HEAD)
    # A branch checked out in another worktree cannot be switched to here.
    local holder=$(git -C $REPO worktree list --porcelain | awk -v b="refs/heads/$branch" '
      /^worktree /{w=$2} /^branch /{if ($2==b) print w}')
    if [[ -n $holder && $holder != $(cd $REPO && pwd -P) ]]; then
      bad "$branch is checked out in another worktree: $holder — remove it (git worktree remove) or run the demo there"
    fi
    # Same trap for the fallback: `git switch <branch>-after` fails mid-demo if it is held elsewhere.
    local after_holder=""
    [[ -n $after ]] && after_holder=$(git -C $REPO worktree list --porcelain | awk -v b="refs/heads/$after" '
      /^worktree /{w=$2} /^branch /{if ($2==b) print w}')
    if [[ -n $after_holder ]]; then
      bad "fallback $after is checked out in another worktree: $after_holder — fallback would fail (git worktree remove)"
    fi
    if [[ $cur == $branch ]]; then ok "on $branch"
    elif [[ $fix == --fix ]]; then
      if [[ -n $(git -C $REPO status --porcelain) ]]; then bad "cannot switch: working tree dirty"
      else git -C $REPO switch -q $branch && ok "switched to $branch"; fi
    else
      bad "on $cur, expected $branch (--fix switches)"
    fi
    [[ -z $(git -C $REPO status --porcelain) ]] && ok "working tree clean" || bad "working tree dirty — commit or discard first"

    # Fallback branches must be pushed: you may need one mid-sentence.
    local missing=0
    for b in level-1-dictating-after level-2-commanding-after level-3-regulating-after; do
      git -C $REPO show-ref -q --verify refs/remotes/origin/$b || { warn "$b not on origin"; missing=1 }
    done
    (( missing == 0 )) && ok "fallback branches pushed"
  else
    bad "no repository at $REPO"
  fi

  # Level 3 only: the enforcement has to be live in THIS clone.
  if [[ $level == 3 ]]; then
    local hp=$(git -C $REPO config --get core.hooksPath 2>/dev/null)
    if [[ $hp == .githooks ]]; then
      ok "git hooks enabled (core.hooksPath=.githooks)"
    elif [[ $fix == --fix ]]; then
      git -C $REPO config core.hooksPath .githooks && ok "enabled git hooks in this clone"
    else
      bad "git hooks NOT enabled — the advisory beat will silently do nothing.
         git -C $REPO config core.hooksPath .githooks   (--fix does it)"
    fi
    for f in scripts/check-decision-record.sh scripts/harness-advisory.sh; do
      [[ -x $REPO/$f ]] && ok "$f executable" || bad "$f missing or not executable"
    done
    # The merge gate is demonstrated from a pre-opened red PR, never a live CI wait.
    local pr=$(gh pr view 1 -R Habitat-Thinking/petclinic-loops-at-levels --json state,statusCheckRollup \
      --jq '"\(.state) \(([.statusCheckRollup[]? | select(.conclusion=="FAILURE")] | length))"' 2>/dev/null)
    case $pr in
      "OPEN 0") warn "PR #1 is open but nothing is failing — re-check before the merge-gate beat" ;;
      "OPEN "*) ok "PR #1 open and red (${pr##* } failing check(s))" ;;
      "") warn "could not reach GitHub to check PR #1 — open the tab manually before you start" ;;
      *) bad "PR #1 is $pr, not OPEN — the merge-gate beat needs it open and red" ;;
    esac
  fi

  # Level 4 only: the segment enters the pipeline at a checkpoint, so the checkpoints
  # are the demo. A missing one is a beat that cannot be shown.
  if [[ $level == 4 ]]; then
    local missing_cp=0 unpushed_cp=0 held_cp=0 cp="" cp_holder=""
    for cp in $L4_CHECKPOINTS; do
      git -C $REPO show-ref -q --verify refs/heads/$cp || { bad "checkpoint $cp missing locally"; missing_cp=1 }
      git -C $REPO show-ref -q --verify refs/remotes/origin/$cp || { warn "checkpoint $cp not on origin"; unpushed_cp=1 }
      # A checkpoint held in another worktree cannot be switched to, and the beat that
      # needs it fails mid-segment. Found the hard way: a scratch worktree holding one
      # produces "fatal: already used by worktree at ...".
      cp_holder=$(git -C $REPO worktree list --porcelain | awk -v b="refs/heads/$cp" '
        /^worktree /{w=$2} /^branch /{if ($2==b) print w}')
      [[ -n $cp_holder ]] && { bad "checkpoint $cp is checked out in another worktree: $cp_holder — that beat would fail (git worktree remove)"; held_cp=1 }
    done
    (( missing_cp == 0 )) && ok "all 5 checkpoints present (${L4_CHECKPOINTS})"
    (( held_cp == 0 )) && ok "no checkpoint held in another worktree"
    (( unpushed_cp == 0 )) && ok "checkpoints pushed"
    # The harness beat shows captured output, but the hook has to be live if anyone
    # asks to see it fire — it is the same clone setting Level 3 needs.
    [[ $(git -C $REPO config --get core.hooksPath 2>/dev/null) == .githooks ]] \
      && ok "git hooks enabled (core.hooksPath=.githooks)" \
      || warn "git hooks not enabled — only matters if you run the harness beat live"
  fi

  # Maven cache: a cold cache turns a 21s build into 134s of dead air.
  [[ -d $HOME/.m2/repository/org/springframework/boot ]] && ok "Maven cache warm" \
    || warn "Maven cache looks cold — run ./mvnw -B verify once in $REPO"

  hdr "Result"
  if (( FAILED > 0 )); then
    print -r -- "${RED}$FAILED blocking problem(s)${R}, $WARNED warning(s). Fix before going on."
    return 1
  fi
  print -r -- "${GRN}Ready.${R} $WARNED warning(s)."
  print -r -- "${DIM}Not checkable from here: terminal font size, scrollback cleared, notifications off.${R}"
  return 0
}

# Teleprompter. Each beat: what to say, then the command — run for you, or copied to
# the clipboard when it must be typed into an agent session.
run_segment(){
  local level=$1 timing=0
  [[ ${2:-} == --time ]] && timing=1
  local steps=$HERE/steps-level-$level.txt
  [[ $level == upper ]] && steps=$HERE/steps-upper-levels.txt
  [[ $level == opening ]] && steps=$HERE/steps-opening.txt
  [[ $level == sentinels ]] && steps=$HERE/steps-sentinels.txt
  [[ -f $steps ]] || { print -r -- "No steps file: $steps"; return 1 }

  # The opening runs nothing, switches nothing and needs no profile: five slides and a
  # person talking. There is no machine state for a preflight to check.
  local pf_ok=0
  if [[ $level == opening ]]; then
    print -r -- "${DIM}No preflight for the opening: it runs no command and needs no profile.${R}"
  elif [[ $level == sentinels ]]; then preflight_sentinels || pf_ok=1
  elif [[ $level == upper ]]; then preflight_upper || pf_ok=1
  else preflight $level || pf_ok=1; fi
  (( pf_ok == 0 )) || {
    print -r -- ""
    print -rn -- "${YEL}Preflight failed.${R} Continue anyway? [y/N] "
    read -r a; [[ $a == [yY] ]] || return 1
  }

  # CMDTIME: is optional and splits TIME: into the part spent on the slide before the
  # command runs and the part spent on the terminal after it. Absent, the whole beat
  # budget belongs to the slide and the command side reports as unallocated.
  local -a titles times ctimes says cmds modes
  local title="" time="" ctime="" say="" cmd="" mode=""
  flush(){
    [[ -z $title ]] && return
    titles+=("$title"); times+=("$time"); ctimes+=("$ctime")
    says+=("$say"); cmds+=("$cmd"); modes+=("${mode:-manual}")
    title=""; time=""; ctime=""; say=""; cmd=""; mode=""
  }
  while IFS= read -r line; do
    case $line in
      "### "*) flush; title=${line#\#\#\# } ;;
      "TIME: "*) time=${line#TIME: } ;;
      "CMDTIME: "*) ctime=${line#CMDTIME: } ;;
      "SAY: "*)  say+="${line#SAY: }"$'\n' ;;
      "CMD: "*)  cmd=${line#CMD: } ;;
      "MODE: "*) mode=${line#MODE: } ;;
    esac
  done < $steps
  flush

  local total=${#titles[@]} i=1
  local label="Level $level"
  [[ $level == upper ]] && label="Upper levels"
  [[ $level == opening ]] && label="The opening"
  [[ $level == sentinels ]] && label="Level 5 solo"
  print -r -- ""; print -r -- "${B}$label — $total beats${R}  ${DIM}[Enter] next · [r] repeat · [s] skip · [f] fallback · [q] quit${R}"
  print -r -- "${DIM}Working directory: $REPO${R}"

  # -1 not reached, -2 skipped. Anything else is measured seconds. Each beat has two
  # clocks: slide time runs from the beat appearing to the keypress that advances it,
  # command time from there until you say you are done with the terminal.
  local -a actual cactual; local n=1
  for (( n = 1; n <= total; n++ )) { actual[$n]=-1; cactual[$n]=-1 }
  local beat_start=0 cmd_start=0
  if (( timing )); then
    print -r -- "${DIM}Timing on. A beat's clock runs from when it appears to when you advance;${R}"
    print -r -- "${DIM}a command beat takes one extra Enter so the talk over its output counts.${R}"
  fi

  while (( i <= total )); do
    beat_start=$EPOCHSECONDS
    print -r -- ""; print -r -- "${CYN}────────────────────────────────────────────────────────${R}"
    print -r -- "${B}Beat $i/$total — ${titles[$i]}${R}  ${DIM}${times[$i]}${R}"
    print -r -- ""
    print -rn -- "${says[$i]}" | sed 's/^/  /'
    if [[ -n ${cmds[$i]} ]]; then
      print -r -- ""
      print -r -- "  ${B}\$ ${cmds[$i]}${R}"
      case ${modes[$i]} in
        run)  print -r -- "  ${DIM}[Enter] runs it here${R}" ;;
        copy) print -r -- "  ${DIM}[Enter] copies it to the clipboard — paste into the agent session${R}" ;;
        *)    print -r -- "  ${DIM}type this yourself${R}" ;;
      esac
    fi
    print -r -- ""
    print -rn -- "${DIM}beat $i>${R} "
    read -r key
    case $key in
      q) print -r -- "Stopped."; (( timing )) && timing_report; return 0 ;;
      s) actual[$i]=-2; cactual[$i]=-2; i=$((i+1)); continue ;;
      r) continue ;;
      f) fallback $level; continue ;;
      *)
        actual[$i]=$(( EPOCHSECONDS - beat_start ))
        cmd_start=$EPOCHSECONDS
        case ${modes[$i]} in
          run)  [[ -n ${cmds[$i]} ]] && { print -r -- ""; NOTES=$NOTES eval "cd $REPO && ${cmds[$i]}" } ;;
          copy) [[ -n ${cmds[$i]} ]] && { print -rn -- "${cmds[$i]}" | pbcopy; print -r -- "  ${GRN}copied${R}" } ;;
        esac
        # The output lands after the keypress, so without a second one the time spent
        # talking over it would be charged to the next beat — and every beat with a
        # command would record only the seconds spent reading its prompt.
        if (( timing )) && [[ -n ${cmds[$i]} && ${modes[$i]} != manual ]]; then
          print -r -- ""
          print -rn -- "${DIM}beat $i> [Enter] when you are done with the terminal${R} "
          read -r _
          cactual[$i]=$(( EPOCHSECONDS - cmd_start ))
        fi
        i=$((i+1))
        ;;
    esac
  done
  print -r -- ""; print -r -- "${GRN}Segment complete.${R}"
  (( timing )) && timing_report
}

# Variance table, split two ways. Slide time is the beat before its command runs;
# command time is the terminal. A beat with no command is all slide.
#
# Budgets are what we wrote. Actuals are what happened. Where they disagree the actual
# is the evidence: nothing in any steps file was ever measured until this flag existed.
timing_report(){
  local n=1 sb=0 cb=0 b=0 c=0 ssa=0 sca=0 ssb=0 scb=0 reached=0 t="" col=""
  print -r -- ""
  print -r -- "${B}Timing — $label${R}"
  print -r -- ""
  printf '  %-3s %-30s %13s %13s %18s\n' "" "" "── slide ──" "── command ──" "──── beat ────"
  printf '  %-3s %-30s %6s %6s %6s %6s %6s %6s %7s\n' \
         "#" "Beat" "bdgt" "actl" "bdgt" "actl" "bdgt" "actl" "delta"
  for (( n = 1; n <= total; n++ )); do
    b=$(budget_secs ${times[$n]}); c=$(budget_secs ${ctimes[$n]})
    # CMDTIME is carved out of TIME, never added to it.
    (( c > b )) && c=$b
    local sbud=$(( b - c ))
    if (( actual[$n] < 0 )); then
      [[ ${actual[$n]} == -2 ]] && t="skipped" || t="not run"
      printf '  %-3d %-30s %6s %6s %6s %6s %6s %6s %7s\n' $n "${titles[$n]:0:30}" \
        "$(mmss $sbud)" "—" "$( (( c )) && mmss $c || print -n -- '—')" "—" "$(mmss $b)" "—" "$t"
      continue
    fi
    reached=$((reached+1))
    local sact=${actual[$n]} cact=${cactual[$n]}
    local tact=$sact; (( cact >= 0 )) && tact=$(( sact + cact ))
    ssa=$(( ssa + sact )); ssb=$(( ssb + sbud ))
    (( cact >= 0 )) && { sca=$(( sca + cact )); scb=$(( scb + c )) }
    local d=$(( tact - b )); col=""
    (( d > 15 )) && col=$RED; (( d < -15 )) && col=$YEL
    printf '  %-3d %-30s %6s %6s %6s %6s %6s %6s %s%7s%s\n' $n "${titles[$n]:0:30}" \
      "$(mmss $sbud)" "$(mmss $sact)" \
      "$( (( c )) && mmss $c || print -n -- '—')" "$( (( cact >= 0 )) && mmss $cact || print -n -- '—')" \
      "$(mmss $b)" "$(mmss $tact)" "$col" "$(mmss_signed $d)" "$R"
  done
  print -r -- ""
  printf '  %-34s %6s %6s %6s %6s %6s %6s %7s\n' "$reached of $total beats reached" \
    "$(mmss $ssb)" "$(mmss $ssa)" "$(mmss $scb)" "$(mmss $sca)" \
    "$(mmss $(( ssb + scb )))" "$(mmss $(( ssa + sca )))" \
    "$(mmss_signed $(( (ssa + sca) - (ssb + scb) )))"
  print -r -- ""
  (( reached < total )) && print -r -- "${YEL}Partial run.${R} Totals cover the beats you reached, not the segment."
  print -r -- "${DIM}Slide = the beat before its command ran. Command = the terminal, until you${R}"
  print -r -- "${DIM}said you were done with it. Red is over beat budget by >15s, yellow under.${R}"
  print -r -- "${DIM}Budgets are written, not measured. After this run, the actuals are.${R}"
}

fallback(){
  local level=$1 after=$(after_for $1)
  print -r -- ""
  # Level 4 has no `-after` sibling. Its fallback is the checkpoint the beat was
  # heading for anyway, which is why the segment is built on them in the first place.
  if [[ -z $after ]]; then
    print -r -- "${YEL}Fallback:${R} Level 4 has no -after branch. Switch to the checkpoint for the beat you are on:"
    # Beats are not one per checkpoint: 3 and 4 both read the slicing record, and so
    # do 6 and 7 with the objections. The numbers are written out rather than counted.
    local -a where=("beats 3-4, the slicing record" "beat 5, the spec" \
                    "beats 6-7, the objections" "beat 8, the choice stories" \
                    "beat 9, the code review")
    local i=1 cp=""
    for cp in $L4_CHECKPOINTS; do
      printf "  git switch %-16s ${DIM}(%s)${R}\n" "$cp" "${where[$i]}"
      i=$((i+1))
    done
    print -r -- "  git switch level-4-orchestrating   ${DIM}(the finished state)${R}"
    print -r -- "Say you have run it before and show the result. That is true."
    return 0
  fi
  print -r -- "${YEL}Fallback:${R} switching to $after (committed, unedited, builds green)."
  print -r -- "Say it is a recording. The audience forgives a fallback, not a fiction."
  git -C $REPO switch -q $after && git -C $REPO log --oneline -1
}

profiles(){
  print -r -- ""; print -r -- "${B}Profiles${R}"
  local p="" a=""
  for l in 1 2; do
    p=$(profile_dir $l)
    if auth_ok $p; then a="${GRN}logged in${R}"; else a="${RED}logged OUT${R}"; fi
    print -r -- "  Level $l  $p  [$a]"
    print -r -- "           launcher: $p/launch"
  done
  print -r -- ""; print -r -- "${DIM}The launchers differ by one flag: Level 2 adds --plugin-dir.${R}"
  print -r -- "${DIM}Neither passes USER: with a custom config dir that breaks the keychain lookup.${R}"
}

case ${1:-} in
  preflight)
    if [[ ${2:?level} == opening ]]; then print -r -- "The opening needs no preflight: no command, no profile, no branch."
    elif [[ ${2:?level} == sentinels ]]; then preflight_sentinels ${3:-}
    elif [[ ${2:?level} == upper ]]; then preflight_upper ${3:-}
    else preflight $2 ${3:-}; fi ;;
  run)       run_segment ${2:?level} ${3:-} ;;
  fallback)  fallback ${2:?level} ;;
  profiles)  profiles ;;
  *) print -r -- "usage: demo {preflight|run|fallback} <opening | 1-5 | upper | sentinels> [--time] | demo profiles" ; exit 2 ;;
esac
